# ===== 大模型（可插拔：deepseek 主力 / claude / qwen）=====
# 在 https://platform.deepseek.com 申请 API Key
# LLM_MOCK=1 时使用内置模拟模型，无需 key，可离线体验全部 AI 功能
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
LLM_MOCK=0
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_MAX_RETRIES=3
LLM_MIN_INTERVAL=1.0
LLM_TIMEOUT=30.0
# Claude（可选，设置 LLM_PROVIDER=claude 启用）
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# 通义千问（可选，设置 LLM_PROVIDER=qwen 启用，DashScope 兼容模式）
QWEN_API_KEY=
QWEN_MODEL=qwen-plus
# 本地模型（可选，设置 LLM_PROVIDER=local 启用；需安装 Ollama 并 ollama pull qwen2.5:7b）
LOCAL_BASE_URL=http://127.0.0.1:11434/v1
LOCAL_MODEL=qwen2.5:7b

# ===== ML 自动重训（1=每周日自动重训并监控 OOS 性能，退化时推送告警）=====
ML_AUTO_RETRAIN=0

# ===== 自选池（逗号分隔的股票/指数代码，每日自动同步数据）=====
WATCHLIST=600519,000001,510300,159915

# ===== 数据源：akshare（默认） / tushare（预留，需实现后启用）=====
DATA_SOURCE=akshare

# ===== 服务 =====
HOST=127.0.0.1
PORT=8000
TIMEZONE=Asia/Shanghai

# ===== 回测默认费用与规则（可在回测请求中覆盖）=====
# 佣金费率 0.025%、最低 5 元；印花税仅卖出 0.05%；过户费 0.001%；滑点 0.01 元/股
COMMISSION_RATE=0.00025
COMMISSION_MIN=5.0
STAMP_TAX_RATE=0.0005
TRANSFER_FEE_RATE=0.00001
SLIPPAGE=0.01
PRICE_LIMIT_RATIO=0.10

# ===== 模拟盘 =====
# AI 风控模式：block(拦截) / warn(放行并警告) / off(关闭)
AI_RISK_MODE=warn
# 模拟盘自动策略名（如 dual_ma），空 = 仅手动交易；每日 14:50 触发信号，次日撮合
PAPER_STRATEGY=
# 亏损限额（0=关闭）：单笔亏损超比例强制卖出；单日亏损超比例次日暂停开仓
PAPER_MAX_LOSS_PER_TRADE=0
PAPER_MAX_DAILY_LOSS=0

# ===== 通知推送（全部可选，不配置则跳过；成交与 AI 日报会推送）=====
# 邮件：SMTP_SSL，如 QQ 邮箱 smtp.qq.com:465
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
NOTIFY_EMAIL_TO=
# Server酱（微信推送）：https://sct.ftqq.com 申请 SendKey
SERVERCHAN_KEY=
# Telegram：BotFather 申请 token，聊天 ID 可用 @userinfobot 查询
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
